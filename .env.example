# .env.example - Environment Configuration Template
# Copy to .env and fill in your values

# ===== Flask Configuration =====
FLASK_SECRET_KEY=your-secret-key-here

# ===== AI API Keys =====
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ===== Ollama Configuration =====
OLLAMA_HOST=localhost:11434
# Set to 0.0.0.0:11434 for remote access

# ===== Database =====
# Database path (default: same directory as server.py)
# DB_PATH=DB.db

# ===== Network Paths =====
# Excel data path for Tool Open (UNC path format)
# EXCEL_PATH=\\\\192.168.2.165\越南vp共享文件夹\09-工程图纸 Bản vẽ Kỹ Thuật Công Trình\存货档案库.xlsx

# ===== Session Configuration =====
# Session timeout in seconds (default: 86400 = 24 hours)
# SESSION_TIMEOUT=86400

# ===== Admin Password =====
# WARNING: Change this! This is used for history deletion
# ADMIN_PASSWORD=kelly

# ===== AI Retry Configuration =====
# MAX_RETRIES=3
# INITIAL_DELAY_MS=1000
# MAX_DELAY_MS=10000